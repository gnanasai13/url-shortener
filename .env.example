APP_NAME="URL Shortener API"
APP_ENV=local
DEBUG=true
API_V1_PREFIX=/api/v1

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=url_shortener
MYSQL_PASSWORD=url_shortener_password
MYSQL_DATABASE=url_shortener

DATABASE_URL=mysql+asyncmy://url_shortener:url_shortener_password@mysql:3306/url_shortener

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=change-me-before-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
